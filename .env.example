# Copy this file to .env and fill in your MySQL details.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=desk_duel

# For hosted MySQL, set DATABASE_URL instead of the individual DB_* values.
# Format: mysql://username:password@hostname:3306/database_name
# URL-encode special characters in the username or password.
# DATABASE_URL=mysql://user:password@db.example.com:3306/desk_duel

# Optional: PIN needed to add/edit/delete questions on the Question Bank page.
ADMIN_PIN=

# PIN required to open host setup and create games.
HOST_PIN=2002

# Optional: the address players should open on their phones.
# Leave blank and the server detects its office-network address automatically.
# PUBLIC_URL=http://192.168.1.20:8000

# For separate online frontend/API deployments, set these to the public frontend URL.
# PUBLIC_URL=https://your-game.vercel.app
# FRONTEND_ORIGINS=https://your-game.vercel.app
